tt=dede('%F0%9F%89%8E%84%8F%EC%BC%A1%A8%BC%A2%F1%E9%FF%F9%ED%E8%EC%AA%A4%A5%AF%A4%F1%A8%AD%A2%BC%AF%BE%EB%AA%A3%BA%AE%A9%B9%F5%FC%F6%F6%98%89%87%88%91%F4%F0%9F%9A%F2%F4%9E%88%F5%F4%8A%87%98%81%F5%F4%85%86%9A%99%9F%E8%A3%A6%A9%A0%A2%AB%A7%F5%E8%AB%A4%AF%A3%E0%E3%F7%E9%E8%B8%B1%BA%A9%F6%AA%B9%BC%BE%A3%A5%E8%BA%A9%A6%B9%AE%F5%EE%8B%A6%A5%A8%A3%EC%A0%AF%BE%AE%E8%B8%A7%EA%AD%A8%AB%A9%BB%B9%EC%A4%BD%BE%E8%B9%A5%BF%AD%EE%E8%A4%AD%A6%AD%F1%8A%9F%98%9F%87%82%E8%A5%A2%A7%A1%AF%A3%F7%EE%AC%A7%E4%E1%E8%F2%EB%F4%E3%8E%85%9E%86%F6%F0%E7%9E%88%F5%F4%E3%9C%98%F2%F7%E7%98%8A%85%88%92%F6%F0%E7%9E%8D%89%84%89%F6%F6%88%82%9E%EC%A9%A6%A5%AC%A6%F1%AB%AF%A2%BF%AD%BE%F6%F6%8E%99%F6%F0%E7%8E%85%9D%F6%F0%E7%9E%88%F5%F4%E3%9C%98%F2%F7%E7%98%8A%85%88%92%F6%F0%E7%9E%8D%89%84%89%F6%F6%E3%9F%8C%F2%F4%E5%98%99%F6%F0%E7%9E%8E%84%8C%95%F6%F6%E3%9F%89%8E%84%8F%F2','347375');
